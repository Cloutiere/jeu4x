{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker + Durable Objects — DESIGN.md §3.2.
  // Déploiement : voir README.md (documenté, non exécuté sans compte Cloudflare).
  "name": "game-4x-server",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // SQLite est le stockage des DO (obligatoire pour les nouveaux DO) — §3.5.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameDO", "LobbyDO"] }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "GAME", "class_name": "GameDO" },
      { "name": "LOBBY", "class_name": "LobbyDO" }
    ]
  },
  "observability": {
    "enabled": true
  },
  // Environnements Wrangler 4 (clé racine `env`) :
  //  - top-level = dev local (`wrangler dev`, secrets dans .dev.vars non committé) ;
  //  - `prod` = `wrangler deploy --env prod` (secrets via `wrangler secret put`).
  //  Les bindings `durable_objects` ne sont PAS hérités : répétés dans prod.
  "env": {
    "prod": {
      "name": "game-4x-server-prod",
      "durable_objects": {
        "bindings": [
          { "name": "GAME", "class_name": "GameDO" },
          { "name": "LOBBY", "class_name": "LobbyDO" }
        ]
      }
    }
  }
}
